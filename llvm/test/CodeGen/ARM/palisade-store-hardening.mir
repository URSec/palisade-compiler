# RUN: llc -mtriple=thumbv8.1m.main-none-eabi -mcpu=cortex-m85 -run-pass=arm-palisade-store-hardening -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,LE
# RUN: llc -mtriple=thumbv8.1m.main-none-eabi -mcpu=cortex-m85 -run-pass=arm-palisade-store-hardening,arm-palisade-store-hardening -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,LE
# RUN: llc -mtriple=thumbebv8.1m.main-none-eabi -mcpu=cortex-m85 -run-pass=arm-palisade-store-hardening -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,BE
# RUN: llc -mtriple=thumbv8.1m.main-none-eabi -mcpu=cortex-m85 -start-after=arm-pseudo -arm-enable-palisade-store-hardening -verify-machineinstrs -filetype=obj %s -o /dev/null

--- |
  ; Hardened stores name IR memory through %p.
  define void @domains(ptr %p, ptr addrspace(200) %q) {
    %local = alloca i32
    ret void
  }
  define void @immediates(ptr %p) { ret void }
  define void @register_offsets(ptr %p) { ret void }
  define void @writeback(ptr %p) { ret void }
  define void @multiple(ptr %p) { ret void }
  define void @floating_point(ptr %p) { ret void }
  define void @undef_value(ptr %p) { ret void }
  define void @free_register(ptr %p) { ret void }
  define void @save_one(ptr %p) { ret void }
  define void @save_two(ptr %p) { ret void }
  define void @reuse_register_offset(ptr %p) { ret void }
  define void @sp_relative(ptr %p) { ret void }
  define void @predicated(ptr %p) { ret void }
...
---
name: domains
tracksRegLiveness: true
frameInfo:
  stackSize: 12
stack:
  - { id: 0, name: local, offset: -4, size: 4, alignment: 4 }
  - { id: 1, type: spill-slot, offset: -8, size: 4, alignment: 4 }
body: |
  bb.0:
    liveins: $r0, $r1
    ; Hardened: memory operands naming IR memory outside __protected.
    ; Kept: __protected IR memory, compiler stack memory (frame slot, spill
    ; slot, outgoing argument), no IR value, no memory operand, and a store
    ; that is already unprivileged.
    ; CHECK-LABEL: name: domains
    ; CHECK:      t2STRT $r1, $r0, 0, 14
    ; CHECK-NEXT: t2STRT $r1, $r0, 4, 14
    ; CHECK-NEXT: t2STRT $r1, $sp, 8, 14
    ; CHECK-NEXT: t2STRi12 $r1, $r0, 8, 14
    ; CHECK-NEXT: t2STRi12 $r1, $sp, 8, 14
    ; CHECK-NEXT: t2STRi12 $r1, $sp, 4, 14
    ; CHECK-NEXT: t2STRi12 $r1, $sp, 0, 14
    ; CHECK-NEXT: t2STRi12 $r1, $r0, 12, 14
    ; CHECK-NEXT: t2STRi12 $r1, $r0, 16, 14
    ; CHECK-NEXT: t2STRT $r1, $r0, 20, 14
    t2STRi12 $r1, $r0, 0, 14, $noreg :: (volatile store (s32) into %ir.p)
    t2STRi12 $r1, $r0, 4, 14, $noreg :: (store monotonic (s32) into %ir.p)
    t2STRi12 $r1, $sp, 8, 14, $noreg :: (store (s32) into %ir.local)
    t2STRi12 $r1, $r0, 8, 14, $noreg :: (store (s32) into %ir.q, addrspace 200)
    t2STRi12 $r1, $sp, 8, 14, $noreg :: (store (s32) into %stack.0.local)
    t2STRi12 $r1, $sp, 4, 14, $noreg :: (store (s32) into %stack.1)
    t2STRi12 $r1, $sp, 0, 14, $noreg :: (store (s32) into stack)
    t2STRi12 $r1, $r0, 12, 14, $noreg :: (store (s32))
    t2STRi12 $r1, $r0, 16, 14, $noreg
    t2STRT $r1, $r0, 20, 14, $noreg :: (store (s32) into %ir.p)
    tBX_RET 14, $noreg
...
---
name: immediates
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1
    ; STRT takes offsets 0-255. Others need an address temporary, and SP must
    ; be copied to a GPR before it can be stored.
    ; CHECK-LABEL: name: immediates
    ; CHECK:      t2STRT $r1, $r0, 124, 14
    ; CHECK-NEXT: t2STRHT $r1, $r0, 62, 14
    ; CHECK-NEXT: t2STRBT $r1, $r0, 31, 14
    ; CHECK-NEXT: t2STRT $r1, $sp, 252, 14
    ; CHECK-NEXT: t2STRT $r1, $r0, 255, 14
    ; CHECK-NEXT: $r2 = t2ADDri12 $r0, 256, 14
    ; CHECK-NEXT: t2STRHT $r1, $r2, 0, 14
    ; CHECK-NEXT: $r2 = t2SUBri12 $r0, 255, 14
    ; CHECK-NEXT: t2STRBT $r1, $r2, 0, 14
    ; CHECK-NEXT: $r1 = t2ADDri12 $sp, 0, 14
    ; CHECK-NEXT: t2STRT $r1, $r0, 0, 14
    tSTRi $r1, $r0, 31, 14, $noreg :: (store (s32) into %ir.p)
    tSTRHi $r1, $r0, 31, 14, $noreg :: (store (s16) into %ir.p)
    tSTRBi $r1, $r0, 31, 14, $noreg :: (store (s8) into %ir.p)
    tSTRspi $r1, $sp, 63, 14, $noreg :: (store (s32) into %ir.p)
    t2STRi12 $r1, $r0, 255, 14, $noreg :: (store (s32) into %ir.p, align 1)
    t2STRHi12 $r1, $r0, 256, 14, $noreg :: (store (s16) into %ir.p)
    t2STRBi8 $r1, $r0, -255, 14, $noreg :: (store (s8) into %ir.p)
    t2STRi12 $sp, $r0, 0, 14, $noreg :: (store (s32) into %ir.p)
    tBX_RET 14, $noreg
...
---
name: register_offsets
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $cpsr
    ; The value may alias the base or index, so the address goes to a temporary.
    ; CHECK-LABEL: name: register_offsets
    ; CHECK:      $r2 = t2ADDrs $r0, $r1, 26, 1 {{.*}} $cpsr
    ; CHECK-NEXT: t2STRT $r0, $r2, 0, 1 {{.*}} $cpsr
    ; CHECK-NEXT: $r2 = t2ADDrs $r0, $r1, 2, 14
    ; CHECK-NEXT: t2STRBT $r1, $r2, 0, 14
    ; CHECK-NEXT: $r2 = t2ADDrs $r0, $r1, 2, 14
    ; CHECK-NEXT: t2STRHT $r1, $r2, 0, 14
    t2STRs $r0, $r0, $r1, 3, 1, $cpsr :: (store (s32) into %ir.p)
    tSTRBr $r1, $r0, $r1, 14, $noreg :: (store (s8) into %ir.p)
    tSTRHr $r1, $r0, $r1, 14, $noreg :: (store (s16) into %ir.p)
    tBX_RET 14, $noreg, implicit $r0, implicit $r1, implicit $cpsr
...
---
name: writeback
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2
    ; The base is updated before a pre-indexed store and after a post-indexed one.
    ; CHECK-LABEL: name: writeback
    ; CHECK:      $r0 = t2SUBri12 $r0, 4, 14
    ; CHECK-NEXT: t2STRT $r1, $r0, 0, 14
    ; CHECK-NEXT: t2STRHT $r1, $r0, 0, 14
    ; CHECK-NEXT: $r0 = t2ADDri12 $r0, 2, 14
    ; CHECK-NEXT: $r0 = t2ADDri12 $r0, 8, 14
    ; CHECK-NEXT: t2STRT $r1, $r0, 0, 14
    ; CHECK-NEXT: t2STRT $r2, $r0, 4, 14
    ; CHECK-NEXT: t2STRT $r1, $r0, 0, 14
    ; CHECK-NEXT: t2STRT $r2, $r0, 4, 14
    ; CHECK-NEXT: $r0 = t2SUBri12 $r0, 8, 14
    early-clobber $r0 = t2STR_PRE $r1, $r0, -4, 14, $noreg :: (store (s32) into %ir.p)
    early-clobber $r0 = t2STRH_POST $r1, $r0, 2, 14, $noreg :: (store (s16) into %ir.p)
    early-clobber $r0 = t2STRD_PRE $r1, $r2, $r0, 8, 14, $noreg :: (store (s64) into %ir.p)
    early-clobber $r0 = t2STRD_POST $r1, $r2, $r0, -8, 14, $noreg :: (store (s64) into %ir.p)
    tBX_RET 14, $noreg, implicit $r0
...
---
name: multiple
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $r3
    ; CHECK-LABEL: name: multiple
    ; CHECK:      $r12 = t2ADDri12 $r0, 252, 14
    ; CHECK-NEXT: t2STRT $r1, $r12, 0, 14
    ; CHECK-NEXT: t2STRT $r2, $r12, 4, 14
    ; CHECK-NEXT: t2STRT $r1, $r0, 0, 14
    ; CHECK-NEXT: t2STRT $r2, $r0, 4, 14
    ; CHECK-NEXT: $r12 = t2SUBri12 $r0, 8, 14
    ; CHECK-NEXT: t2STRT $r1, $r12, 0, 14
    ; CHECK-NEXT: t2STRT $r2, $r12, 4, 14
    ; CHECK-NEXT: t2STRT $r1, $r0, 0, 14
    ; CHECK-NEXT: t2STRT $r2, $r0, 4, 14
    ; CHECK-NEXT: t2STRT $r3, $r0, 8, 14
    ; CHECK-NEXT: $r0 = t2ADDri12 $r0, 12, 14
    ; CHECK-NEXT: $r3 = t2SUBri12 $r0, 8, 14
    ; CHECK-NEXT: t2STRT $r1, $r3, 0, 14
    ; CHECK-NEXT: t2STRT $r2, $r3, 4, 14
    ; CHECK-NEXT: $r0 = t2SUBri12 $r0, 8, 14
    t2STRDi8 $r1, $r2, $r0, 252, 14, $noreg :: (store (s64) into %ir.p, align 4)
    t2STMIA $r0, 14, $noreg, $r1, $r2 :: (store (s64) into %ir.p, align 4)
    t2STMDB $r0, 14, $noreg, $r1, $r2 :: (store (s64) into %ir.p, align 4)
    $r0 = t2STMIA_UPD $r0, 14, $noreg, $r1, $r2, $r3 :: (store (s96) into %ir.p, align 4)
    $r0 = t2STMDB_UPD $r0, 14, $noreg, $r1, $r2 :: (store (s64) into %ir.p, align 4)
    tBX_RET 14, $noreg, implicit $r0
...
---
name: floating_point
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $d0, $s2
    ; FP bits are moved to a GPR. A D register is stored as two words in
    ; memory order.
    ; CHECK-LABEL: name: floating_point
    ; CHECK:      $r1 = VMOVRS $s2, 14
    ; CHECK-NEXT: t2STRT $r1, $r0, 0, 14
    ; CHECK-NEXT: $r2 = t2ADDri12 $r0, 1020, 14
    ; LE-NEXT:    $r1 = VMOVRS $s0, 14
    ; BE-NEXT:    $r1 = VMOVRS $s1, 14
    ; CHECK-NEXT: t2STRT $r1, $r2, 0, 14
    ; LE-NEXT:    $r1 = VMOVRS $s1, 14
    ; BE-NEXT:    $r1 = VMOVRS $s0, 14
    ; CHECK-NEXT: t2STRT $r1, $r2, 4, 14
    ; LE-NEXT:    $r1 = VMOVRS $s0, 14
    ; BE-NEXT:    $r1 = VMOVRS $s1, 14
    ; CHECK-NEXT: t2STRT $r1, $r0, 0, 14
    ; LE-NEXT:    $r1 = VMOVRS $s1, 14
    ; BE-NEXT:    $r1 = VMOVRS $s0, 14
    ; CHECK-NEXT: t2STRT $r1, $r0, 4, 14
    ; CHECK-NEXT: $r2 = t2SUBri12 $r0, 8, 14
    ; CHECK-NEXT: $r1 = VMOVRS $s0, 14
    ; CHECK-NEXT: t2STRT $r1, $r2, 0, 14
    ; CHECK-NEXT: $r1 = VMOVRS $s1, 14
    ; CHECK-NEXT: t2STRT $r1, $r2, 4, 14
    ; CHECK-NEXT: $r0 = t2SUBri12 $r0, 8, 14
    VSTRS $s2, $r0, 0, 14, $noreg :: (store (s32) into %ir.p)
    VSTRD $d0, $r0, 255, 14, $noreg :: (store (s64) into %ir.p)
    VSTMDIA $r0, 14, $noreg, $d0 :: (store (s64) into %ir.p, align 4)
    $r0 = VSTMSDB_UPD $r0, 14, $noreg, $s0, $s1 :: (store (s64) into %ir.p, align 4)
    tBX_RET 14, $noreg, implicit $r0
...
---
name: undef_value
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0
    ; CHECK-LABEL: name: undef_value
    ; CHECK:      $r1 = VMOVRS undef $s
    ; CHECK-NEXT: t2STRT $r1, $r0, 0, 14
    ; CHECK-NEXT: $r1 = VMOVRS undef $s
    ; CHECK-NEXT: t2STRT $r1, $r0, 4, 14
    VSTRD undef $d0, $r0, 0, 14, $noreg :: (store (s64) into %ir.p)
    tBX_RET 14, $noreg
...
---
name: free_register
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $lr
    ; r2 is dead after the store, so it needs no save.
    ; CHECK-LABEL: name: free_register
    ; CHECK:      $r2 = t2ADDri12 $r0, 1024, 14
    ; CHECK-NEXT: t2STRT $r1, $r2, 0, 14
    ; CHECK-NEXT: tBX_RET
    t2STRi12 $r1, $r0, 1024, 14, $noreg :: (store (s32) into %ir.p)
    tBX_RET 14, $noreg
...
---
name: save_one
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $lr
    ; Every GPR is live, but the base is not the stored value, so it is adjusted
    ; in place and restored instead of spilling an address temporary.
    ; CHECK-LABEL: name: save_one
    ; CHECK:      $r0 = t2ADDri12 $r0, 1024, 14
    ; CHECK-NEXT: t2STRT $r1, $r0, 0, 14
    ; CHECK-NEXT: $r0 = t2SUBri12 $r0, 1024, 14
    ; CHECK-NEXT: tBX_RET
    t2STRi12 $r1, $r0, 1024, 14, $noreg :: (store (s32) into %ir.p)
    tBX_RET 14, $noreg, implicit $r0, implicit $r1, implicit $r2, implicit $r3, implicit $r4, implicit $r5, implicit $r6, implicit $r7, implicit $r8, implicit $r9, implicit $r10, implicit $r11, implicit $r12, implicit $lr
...
---
name: save_two
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $lr, $s0
    ; The FP value still needs a data temporary (spilled), but the address
    ; reuses the base in place rather than spilling a second register.
    ; CHECK-LABEL: name: save_two
    ; CHECK:      early-clobber $sp = t2STR_PRE $r1, $sp, -4, 14
    ; CHECK-NEXT: $r0 = t2ADDri12 $r0, 1020, 14
    ; CHECK-NEXT: $r1 = VMOVRS $s0, 14
    ; CHECK-NEXT: t2STRT $r1, $r0, 0, 14
    ; CHECK-NEXT: $r0 = t2SUBri12 $r0, 1020, 14
    ; CHECK-NEXT: $r1, $sp = t2LDR_POST $sp, 4, 14
    ; CHECK-NEXT: tBX_RET
    VSTRS $s0, $r0, 255, 14, $noreg :: (store (s32) into %ir.p)
    tBX_RET 14, $noreg, implicit $r0, implicit $r1, implicit $r2, implicit $r3, implicit $r4, implicit $r5, implicit $r6, implicit $r7, implicit $r8, implicit $r9, implicit $r10, implicit $r11, implicit $r12, implicit $lr
...
---
name: reuse_register_offset
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $lr
    ; A register-offset store with no free register: the base is distinct from
    ; the value and the index, so it is adjusted by the index in place and
    ; restored, instead of spilling.
    ; CHECK-LABEL: name: reuse_register_offset
    ; CHECK:      $r0 = t2ADDrs $r0, $r1, 26, 14
    ; CHECK-NEXT: t2STRT $r2, $r0, 0, 14
    ; CHECK-NEXT: $r0 = t2SUBrs $r0, $r1, 26, 14
    ; CHECK-NEXT: tBX_RET
    t2STRs $r2, $r0, $r1, 3, 14, $noreg :: (store (s32) into %ir.p)
    tBX_RET 14, $noreg, implicit $r0, implicit $r1, implicit $r2, implicit $r3, implicit $r4, implicit $r5, implicit $r6, implicit $r7, implicit $r8, implicit $r9, implicit $r10, implicit $r11, implicit $r12, implicit $lr
...
---
name: sp_relative
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $lr
    ; Offsets from SP, and a stored SP value, are corrected for the push.
    ; CHECK-LABEL: name: sp_relative
    ; CHECK:      $sp = t2STMDB_UPD $sp, 14 {{.*}}, $r0, $r1
    ; CHECK-NEXT: $r1 = t2ADDri12 $sp, 260, 14
    ; CHECK-NEXT: $r0 = t2ADDri12 $sp, 8, 14
    ; CHECK-NEXT: t2STRT $r0, $r1, 0, 14
    ; CHECK-NEXT: $sp = t2LDMIA_UPD $sp, 14 {{.*}}, def $r0, def $r1
    ; CHECK-NEXT: early-clobber $sp = t2STR_PRE $r1, $sp, -4, 14
    ; CHECK-NEXT: $r1 = t2ADDri12 $sp, 4095, 14
    ; CHECK-NEXT: $r1 = t2ADDri12 $r1, 4, 14
    ; CHECK-NEXT: t2STRT $r0, $r1, 0, 14
    ; CHECK-NEXT: $r1, $sp = t2LDR_POST $sp, 4, 14
    t2STRi12 $sp, $sp, 252, 14, $noreg :: (store (s32) into %ir.p)
    t2STRi12 $r0, $sp, 4095, 14, $noreg :: (store (s32) into %ir.p, align 1)
    tBX_RET 14, $noreg, implicit $r0, implicit $r1, implicit $r2, implicit $r3, implicit $r4, implicit $r5, implicit $r6, implicit $r7, implicit $r8, implicit $r9, implicit $r10, implicit $r11, implicit $r12, implicit $lr
...
---
name: predicated
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r0, $r1, $r2, $r3, $r4, $r5, $r6, $r7, $r8, $r9, $r10, $r11, $r12, $lr, $cpsr
    ; The push and pop are unconditional; the lowered store keeps its predicate.
    ; CHECK-LABEL: name: predicated
    ; CHECK:      early-clobber $sp = t2STR_PRE $r2, $sp, -4, 14
    ; CHECK-NEXT: $r2 = t2ADDrs $r0, $r1, 18, 1 {{.*}} $cpsr
    ; CHECK-NEXT: t2STRT $r0, $r2, 0, 1 {{.*}} $cpsr
    ; CHECK-NEXT: $r2, $sp = t2LDR_POST $sp, 4, 14
    t2STRs $r0, $r0, $r1, 2, 1, $cpsr :: (store (s32) into %ir.p)
    tBX_RET 14, $noreg, implicit $r0, implicit $r1, implicit $r2, implicit $r3, implicit $r4, implicit $r5, implicit $r6, implicit $r7, implicit $r8, implicit $r9, implicit $r10, implicit $r11, implicit $r12, implicit $lr, implicit $cpsr
...
